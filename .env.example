# ===== INTEGRA (etapa de integracao — somente leitura) =====
INTEGRA_URL=https://www.integra.adv.br/
INTEGRA_LOGIN_URL=https://www.integra.adv.br/login-integra.asp
# Tela "Pesquisa de publicacoes" (validada em 08/10/2026). O menu leva a outra pagina (modulo 132).
INTEGRA_PUBLICACOES_URL=https://www.integra.adv.br/moderno/modulo/38/default.asp
# manual (recomendado) = voce faz o login na janela do Chrome do robo
# auto = usa as credenciais abaixo — SOMENTE conta tecnica do robo, nunca a de uma pessoa
INTEGRA_LOGIN_MODE=manual
INTEGRA_USER=
INTEGRA_PASS=
INTEGRA_LOGIN_TIMEOUT=300
INTEGRA_HEADLESS=false
INTEGRA_PROFILE_DIR=./.browser/integra

# ===== Painel / banco operacional (o mesmo do dashboard) =====
AGENT_DB=var/operational.sqlite
DASHBOARD_PORT=8000

# ===== DataJud =====
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ===== Google Drive (gere NOVA chave; a anterior foi exposta no chat) =====
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

DATABASE_URL=sqlite:///./agente.db
SELENIUM_TIMEOUT=20

# ===== WhatsApp (docs/WHATSAPP_UAZAPI_PASSO_A_PASSO.md) =====
# meta = Cloud API oficial (template) | uazapi = numero conectado na UazAPI (escolhido pelo escritorio)
WA_PROVIDER=uazapi
WA_INTEGRA_ENABLED=false
WA_ATENDENTE_ENABLED=false
WA_RECIPIENTS_FILE=var/whatsapp-recipients.json
WA_INCLUIR_PARTES=false
WA_PANEL_URL=
# UazAPI: endereco do SEU servidor e token da INSTANCIA (nunca o admintoken)
UAZAPI_URL=
UAZAPI_TOKEN=
# Somente se WA_PROVIDER=meta:
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
WA_TEMPLATE_PUBLICACOES=aviso_publicacoes_integra
WA_LANGUAGE=pt_BR

# ===== IA no atendente (docs/WHATSAPP_IA_PASSO_A_PASSO.md) - configure com scripts\configurar_ia.py =====
WA_IA_ENABLED=false
# claude (pago, le PDF e fotos) | groq (gratuito, nuvem) | ollama (gratuito, neste PC)
# Ordem de uso automatica (o robo troca sozinho se um falhar): claude > groq > ollama
IA_PROVEDORES=groq,ollama
# GROQ_MODELO_STT: transcricao de audio de reserva (quando a ElevenLabs falhar)
GROQ_MODELO_STT=whisper-large-v3-turbo
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:7b
# true somente se o modelo escolhido le imagens
IA_VISAO=false
# Consulta publica (DataJud/CNJ): chave publica divulgada pelo CNJ
DATAJUD_API_KEY=
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
IA_MAX_TOKENS=1024
# Audio: transcricao LOCAL (pip install faster-whisper) e resposta em voz pt-BR do Windows
WA_WHISPER_MODELO=small
WA_RESPOSTA_VOZ=true
# ElevenLabs (voz natural / transcricao) - configure com scripts\configurar_elevenlabs.py
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO_VOZ=eleven_multilingual_v2
ELEVENLABS_MODELO_STT=scribe_v2
# elevenlabs | windows   e   elevenlabs | local  (vazio = ElevenLabs se houver chave)
VOZ_PROVEDOR=
TRANSCRICAO_PROVEDOR=
